		"body-parser": "^2.4.0",
		"colors": "1.4.0",
		"compression": "^1.8.2",
		"dompurify": "^3.4.17",
		"express": "^4.22.3",
		"http-shutdown": "^1.2.2",
		"js-yaml": "^4.3.2",
		"jsdom": "^29.1.1",
		"jsonwebtoken": "^9.0.3",
		"lru-cache": "^10.4.3",
		"mediawiki-title": "^0.7.5",
		"mysql": "^2.18.1",
