		"globals": "^15.15.0",
		"nodemon": "^3.1.14",
		"openapi-schema-validator": "^12.1.3",
		"supertest": "^7.3.1"
	},
	"scripts": {
		"start": "node ./server.js",
		"dev": "nodemon --signal SIGHUP --legacy-watch --inspect=0.0.0.0 ./server.js -n 0",
		"unittest": "NODE_ENV=test node --test --experimental-test-coverage --test-coverage-lines=77 'test/unittest/**/*.js'",
		"integration": "NODE_ENV=test node --test 'test/integration/**/*.js'",
		"test": "npm run lint && npm run unittest",
		"lint": "eslint ."
	},
	"bin": {
		"cxserver": "./server.js"
	},
	"main": "./server.js"
